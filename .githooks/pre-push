#!/bin/sh
# Only run the public wording check when pushing to the public remote.
if [ -n "$PYTHON" ]; then
  PY="$PYTHON"
elif command -v python >/dev/null 2>&1; then
  PY="python"
elif command -v python3 >/dev/null 2>&1; then
  PY="python3"
else
  echo "python not found" >&2
  exit 1
fi

if [ "$1" = "public" ] || echo "$2" | grep -q "ecommerce-analytics-agent\.git$"; then
  "$PY" scripts/check_public_wording.py || exit 1
fi
